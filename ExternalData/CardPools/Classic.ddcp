  "animationDefineList" : [],
  "ruleLogicList" : [],
  "localizedStringList" : [{
      "value" : "+2/+3，“<b>遗言</b>：召唤一只1/1的<u>老鼠</u>”。",
      "dictionary" : {
        "en-US" : "+2/+3, \"<b>Lastword</b>: Summon a 1/1 <u>Mouse</u>.\"",
        "ja" : "＋２/＋３と「<b>遺言</b>：１/１の<u>「鼠」</u>を１体召喚する」。"
      }
    }, {
      "value" : "+2攻击力，<b>速攻</b>，“<b>遗言</b>：将一张<u>奶酪</u>置入你的手牌”。",
      "dictionary" : {
        "en-US" : "+2 Attack, <b>Rush</b>, \"<b>Lastword</b>: Add a <u>Cheese</u> to you hand.\"",
        "ja" : "攻撃力＋２、<b>急襲</b>、「<b>遺言</b>：<u>「チ\u30fcズ」</u>１枚に自分の手札を追加する」。"
      }
    }, {
      "value" : "<b>信仰对决(仆从牌)</b>\n对一个仆从造成3点伤害。获胜时为你的英雄恢复4点生命值。",
      "dictionary" : {
        "en-US" : "<b>Faithduel (Servant)</b>\nDeal 3 damage to a servant. Restore 4 health for your master if win.",
        "ja" : "<b>信仰対決（ミニオンカ\u30fcド）</b>\nミニオン１体に３ダメ\u30fcジを与える；勝つ場合、自分のヒ\u30fcロ\u30fcの体力を４回復する。"
      }
    }, {
      "value" : "<b>信仰对决(仆从牌)</b>\n对所有敌方仆从造成2点伤害。获胜时抽一张牌。",
      "dictionary" : {
        "en-US" : "<b>Faithduel (Servant)</b>\nDeal 2 damage to all enemy servants. Draw a card if win.",
        "ja" : "<b>信仰対決（ミニオンカ\u30fcド）</b>\n敵のミニオン全てに３ダメ\u30fcジを与える；勝つ場合、カ\u30fcドを１枚引く。"
      }
    }, {
      "value" : "<b>信仰对决(仆从牌)</b>\n选择一个仆从，对与其相邻的仆从造成4点伤害。获胜时对选择的目标造成2点伤害。",
      "dictionary" : {
        "en-US" : "<b>Faithduel (Servant)</b>\nSelect a servant, deal 4 damage to adjacent servants of it. Also deal 2 damage to it if win.",
        "ja" : "<b>信仰対決（ミニオンカ\u30fcド）</b>\nミニオン１体の隣接するミニオンに４ダメ\u30fcジを与える；勝つ場合、このミニオンに２ダメ\u30fcジを与える。"
      }
    }, {
      "value" : "<b>信仰对决</b>，为一个友方仆从恢复2点生命值，如果目标仍处于受伤状态，重复此效果。",
      "dictionary" : {
        "en-US" : "<b>Faithduel</b>, resotre 2 Health for a friendly servant. If it's still damaged, repeat this.",
        "ja" : "<b>信仰対決</b>、味方のミニオン１体に体力を２回復する、その後も対象にダメ\u30fcジが残っている場合、この効果を繰り返す。"
      }
    }, {
      "value" : "<b>元素法术：土</b>\n召唤一个1/1的<u>宝石长枪</u>。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Earth</b>\nSummon a 1/1 <u>Gem Spear</u>.",
        "ja" : "<b>エレメンタルスペル：土</b>\n1/1の<u>「ゲンム\u30fcスピア」</u>を１体召喚する。"
      }
    }, {
      "value" : "<b>元素法术：土</b>\n召唤一个3/9并具有<b>守卫</b>和<b>无法攻击</b>的<u>岩石元素</u>。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Earth</b>\nSummon a 3/9 <u>Rock Elemental</u> with <b>Guard</b> and <b>Can't attack</b>.",
        "ja" : "<b>エレメンタルスペル：土</b>\n<b>守り</b>と<b>攻撃できない</b>を持つ３/９の<u>岩石エレメンタル</u>を１体召喚する。"
      }
    }, {
      "value" : "<b>元素法术：木、土</b>\n使一个仆从获得“<b>遗言</b>：召唤一个自身的原始复制并使其获得+3/+3”。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Wood & Earth</b>\nGive a servant \"<b>Lastword</b>: Summon a copy of this and give it +3/+3.\"",
        "ja" : "<b>エレメンタルスペル：木、土</b>\nミニオン１体に<b>遺言</b>：「自身の新しい複製品を召喚し、＋３/＋３を付与する」を付与する。"
      }
    }, {
      "value" : "<b>元素法术：木、水</b>\n为一个仆从恢复所有生命值并使其获得+3/+6和<b>守卫</b>。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Wood & Water</b>\nFully heal a servant, give it +3/+6 and <b>Guard</b>.",
        "ja" : "<b>エレメンタル：木、水</b>\nミニオン１体の体力を上限まで回復し＋３/＋６と<b>守り</b>を付与する。"
      }
    }, {
      "value" : "<b>元素法术：木、火</b>\n对一个敌方仆从造成等同于你控制仆从数量的伤害，使所有友方仆从获得+2/+2。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Wood & Fire</b>\nDeal damage equal to the number of friendly servants to an enemy servant, give all friendly servants +2/+2.",
        "ja" : "<b>エレメンタルスペル：木、火</b>\n敵のミニオン１体に自分のミニオンの数量に等しいダメ\u30fcジを与える、全ての味方のミニオンに＋２/＋２を付与する。"
      }
    }, {
      "value" : "<b>元素法术：木</b>\n使一个仆从获得+2生命值。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Wood</b>\nGive a servant +2 Health.",
        "ja" : "<b>エレメンタルスペル：木</b>\nミニオン１体に体力＋２を付与する。"
      }
    }, {
      "value" : "<b>元素法术：木</b><br>使一个仆从获得+3/+6。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Wood</b><br>Give a servant +3/+6.",
        "ja" : "<b>エレメンタルスペル：木</b><br>ミニオン１体に＋３/＋６を付与する。"
      }
    }, {
      "value" : "<b>元素法术：水、土</b>\n<b>封印</b>所有仆从，召唤一个2/2并具有<b>守卫</b>的<u>洪水元素</u>。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Earth & Water</b>\n<b>Seal</b> all servants, summon a 2/2 <u>Flood Elemental</u> with <b>Guard</b>.",
        "ja" : "<b>エレメンタルスペル：水、土</b>\n全てのミニオンを<b>封印</b>される、<b>守り</b>を持つ２/２の<u>デリュ\u30fcジュエレメント</u>を１体召喚する。"
      }
    }, {
      "value" : "<b>元素法术：水、火</b>\n造成7点伤害并随机分配给所有敌人。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Water & Fire</b>\nDeal 7 damage randomly split among all enemies.",
        "ja" : "<b>エレメンタルスペル：水、火</b>\n合計７ダメ\u30fcジを全ての敵にランダムに振り分ける。"
      }
    }, {
      "value" : "<b>元素法术：水</b>\n<b>禁锢</b>一个仆从。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Water</b>\n<b>Shackle</b> a servant.",
        "ja" : "<b>エレメンタルスペル：水</b>\nミニオン\u30fc１体を<b>禁固</b>させる。"
      }
    }, {
      "value" : "<b>元素法术：水</b>\n直到你的回合开始时，使所有友方角色每次受到的伤害减少3点。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Water</b>\nAll friendly characters reduce all taken damage by 3 until the start of your next turn.",
        "ja" : "<b>エレメンタルスペル：水</b>\n次の自分のタ\u30fcン開始まで、全ての味方のキャラクタ\u30fcは一度に３ダメ\u30fcジが減って受ける。"
      }
    }, {
      "value" : "<b>元素法术：火、土</b>\n召唤两个2/2并具有<b>守卫</b>且会在你的回合结束时随机对一个敌人造成2点伤害的<u>熔岩元素</u>。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Fire & Earth</b>\nSummon two 2/2 <u>Lava Elementals</u> with <b>Guard</b>, they deal 2 damage to random enemies at the end of turns.",
        "ja" : "<b>エレメンタル：火、土</b>\n<b>守り</b>と「自分のタ\u30fcン終了時、敵のランダムなキャラクタ\u30fcに２ダメ\u30fcジを与える」を持つ２/２の<u>「溶岩エレメント」</u>を召喚する。"
      }
    }, {
      "value" : "<b>元素法术：火</b>\n使一个仆从在本回合中获得+2攻击力。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Fire</b>\nGive a servant +2 Attack this turn.",
        "ja" : "<b>エレメンタルスペル：火</b>\nこのタ\u30fcンの間、ミニオン1体に攻撃力＋２を付与する。"
      }
    }, {
      "value" : "<b>元素法术：火</b><br>造成7点伤害。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Fire</b><br>Deal 7 damage.",
        "ja" : "<b>エレメンタルスペル：火</b><br>７ダメ\u30fcジを与える。"
      }
    }, {
      "value" : "<b>元素法术：金、土</b>\n每有一个敌方仆从，便召唤一个3/1并具有<b>速攻</b>的<u>沙尘元素</u>。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Metal & Earth</b>\nSummon a 3/1 <u>Sand Elemental</u> with <b>Rush</b> for each enemy servant.",
        "ja" : "<b>エレメンタルスペル：金、土</b>\n敵のミニオン１体につき<b>急襲</b>を持つ３/１の<u>「砂塵エレメント」</u>を召喚する。"
      }
    }, {
      "value" : "<b>元素法术：金、木</b>\n对所有敌方仆从造成2点伤害。每消灭一个仆从，便随机使一个友方仆从获得+1/+1。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Metal & Wood</b>\nDeal 2 damage to all enemy servants, give a random friendly servant +1/+1 for each kills.",
        "ja" : "<b>エレメンタルスペル：金、木</b>\n敵のミニオン全てに２ダメ\u30fcジを与える。破壊したミニオン１体につきランダムな味方のミニオンに＋１/＋１を付与する。"
      }
    }, {
      "value" : "<b>元素法术：金、水</b>\n直到你的的回合开始时，使所有敌方仆从获得-3攻击力并消灭攻击力为0的敌方仆从。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Metal & Water</b>\nGive all enemy servants -3 Attack until the start of your next turn. Destroy all 0-Attack enemy servants.",
        "ja" : "<b>エレメンタルスペル：金、水</b>\n次の自分のタ\u30fcン開始まで、敵のミニオン全てに－３攻撃力を付与し、攻撃力が０の敵のミニオンを全て破壊する。"
      }
    }, {
      "value" : "<b>元素法术：金、火</b>\n对一个仆从和敌方英雄造成4点伤害。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Metal & Fire</b>\nDeal 4 damage to a servant and the enemy master.",
        "ja" : "<b>エレメンタルスペル：金、土</b>\nミニオン1体と相手のヒ\u30fcロ\u30fcに４ダメ\u30fcジを与える。"
      }
    }, {
      "value" : "<b>元素法术：金</b>\n对所有敌方仆从造成3点伤害。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Metal</b>\nDeal 3 damage to all enemy servants.",
        "ja" : "<b>エレメンタルスペル：金</b>\n敵のミニオン全てに３ダメ\u30fcジを与える。"
      }
    }, {
      "value" : "<b>元素法术：金</b>\n随机对一个敌方仆从造成2点伤害。",
      "dictionary" : {
        "en-US" : "<b>Elemental Spell: Metal</b>\nDeal 2 damage to a random enemy servant.",
        "ja" : "<b>エレメンタルスペル：金</b>\nランダムな敵のミニオン１体に２ダメ\u30fcジを与える。"
      }
    }, {
      "value" : "<b>唯一</b>\n<b>宣言</b>：将其它仆从移回其拥有者的手牌。",
      "dictionary" : {
        "en-US" : "<b>Unique</b>\n<b>Declare</b>: Return all servants to their owner's hand.",
