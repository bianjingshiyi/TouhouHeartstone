      "_imagePath" : "716ec2b783e8d39a1313c3e1dca68cb791af53b43e581a9c9746e8595e67e65e.jpg",
      "_desc" : "每当你的英雄攻击时，使你的道具获得+1攻击力。"
    }, {
      "_id" : 39,
      "_name" : "妖怪铁匠*",
      "_imagePath" : "37b8d171e74816f3b0c7afcece93cef4af19d31e8bc84971c29689798b9e2a67.jpg",
      "_desc" : "<b>宣言</b>：使你的道具在本回合中获得<b>无敌</b>。"
    }, {
      "_id" : 40,
      "_name" : "列队游魂*",
      "_imagePath" : "69af74fba79cc39ca555cf2119a90a05ab233ff900825d5f7657b3bf37e72ab4.jpg",
      "_desc" : "每当你的回合结束时，如果你拥有护甲值，则召唤一个1/1的幽灵。"
    }, {
      "_id" : 41,
      "_name" : "樱花闪闪*",
      "_imagePath" : "955d9e121dbec7b0c534070a1d7bf73d1e7812ee087ea38e023a933c45155005.jpg",
      "_desc" : "本回合中，你的英雄获得+2攻击力，然后按生命值从低到高的顺序依次攻击所有敌方仆从。"
    }, {
      "_id" : 42,
      "_name" : "幽明的苦轮*",
      "_imagePath" : "b6743f90a1e7ffd5658c7593f5d3e3d3e7c9b369f45f0b453975884f14d6e3c2.jpg",
      "_desc" : "失去所有护甲值，使你的英雄在本回合中获得等同于失去护甲值的攻击力。"
    }, {
      "_id" : 43,
      "_name" : "半幽灵*",
      "_imagePath" : "7ea0691ef5147d727a8d80357d655f5a70855926c804a504a96d3c5e9b2d0326.jpg",
      "_desc" : "你每拥有1点护甲值，此牌便获得+1/+1。"
    }, {
      "_id" : 44,
      "_name" : "天人亦五衰*",
      "_imagePath" : "1ad9195f2c32beb83ccda4adbf1684950fbfe8176c42d5cb106e00f085eedae1.jpg",
      "_desc" : "获得5点护甲值。本回合中，你的英雄获得+5攻击力。"
    }, {
      "_id" : 45,
      "_name" : "星熊勇仪*",
      "_imagePath" : "af7332faa467e2a0720d668ee1b1224a7dc2e3870057b4d19e4886642e08470e.jpg",
      "_desc" : "攻击力最高的敌方仆从每有1点攻击力，此牌灵力值消耗便减少（1）点。"
    }, {
      "_id" : 46,
      "_name" : "黑谷山女*",
      "_imagePath" : "707e70042addf9fe8464a42b560af6b47369797ea43f0036b28e1ed96f99778a.jpg",
      "_desc" : "此牌对仆从造成伤害后，若目标仍存活，使目标剩余生命值变为1点。"
    }, {
      "_id" : 47,
      "_name" : "大妖精*",
      "_imagePath" : "80de0c589a2df8f337e526f23242a5ce61392b96aa4e0fa6fe40df1e2f387282.jpg",
      "_desc" : "<b>速攻</b>\n<b>遗言</b>：本回合中获得1点灵力值。"
    }, {
      "_id" : 48,
      "_name" : "红美铃*",
      "_imagePath" : "aed4a83dca0775306a4038f3df18cd64c5161d1b475441c6b26729ba7e065118.jpg",
      "_desc" : "<b>守卫</b>\n每当此牌受到伤害时，获得+3攻击力。"
    }, {
