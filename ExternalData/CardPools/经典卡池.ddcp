      "_imagePath" : "d86885ddd6c8e72bcd7355832a0781952b377e7d769ef0f802ab37fe3f0fb28d.jpg",
      "_desc" : "使一个英雄生命值减半。",
      "_language" : "zh-Hans"
    }, {
      "_id" : 10,
      "_name" : "蓬莱山辉夜*",
      "_subname" : "永远和须臾的罪人",
      "_imagePath" : "8d1662b3ae7bc4f4da0db9d12ce3648b61bddc4f9ebb202a62cad9aa9d639b1c.jpg",
      "_desc" : "<b>唯一</b>\r\n<b>宣言</b>：选择一项:每个玩家禁止抽牌两个回合；或者每个玩家抽五张牌。",
